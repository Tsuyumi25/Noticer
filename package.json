{
  "name": "noticer",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "import-backup": "pnpm --filter server import-backup",
    "pull-prod": "pnpm --filter server pull-prod"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
